# Contatti — configurazione invio email (Vercel)
# Copia queste variabili in Project → Settings → Environment Variables.
# Non committare mai valori reali.

# Provider consigliato: Resend (https://resend.com)
RESEND_API_KEY=

# Destinatario e mittente verificato
CONTACT_TO=afelektra2@afelektra.com
CONTACT_FROM=AF Elektra 2 <no-reply@afelektra.com>

# Alternativa a Resend: endpoint che riceve il JSON del form
CONTACT_WEBHOOK_URL=

# Solo per test in preview: non invia email, scrive il payload nei log Vercel
CONTACT_DEBUG=0

# Solo se il form viene servito da un hosting PHP (es. Aruba)
# VITE_CONTACT_ENDPOINT=/send.php
